      "variables": ["temperature", "humidity", "wind", "pressure", "radiation", "soil_moisture"],
      "url": "https://cds.climate.copernicus.eu/datasets/reanalysis-era5-single-levels",
      "status": "ADAPTER_REQUIRED"
    },
    {
      "id": "nasa-merra2",
      "provider": "NASA Earthdata / GES DISC",
      "name": "MERRA-2",
