      "url": "https://imdpune.gov.in/cmpg/Griddata/Rainfall_25_NetCDF.html",
      "format": "NetCDF",
      "status": "CONNECTED_WHEN_DATASET_PRESENT"
    },
    {
      "id": "imd-api",
      "provider": "India Meteorological Department",
      "name": "Public weather API",
      "type": "operational-api",
