{
  "schema_version": "1.0",
  "scope": "INDIA",
  "policy": {
    "authoritative_only": true,
    "fabrication_allowed": false,
    "missing_data_statuses": [
      "NO_DATA",
      "NOT_CONNECTED",
      "WAITING_FOR_CREDENTIALS",
      "MODEL_NOT_READY",
      "COMPUTE_NOT_AVAILABLE"
    ]
  },
  "sources": [
