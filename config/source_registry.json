      "url": "https://api.imd.gov.in/public/api_reference.html",
      "status": "ADAPTER_REQUIRED"
    },
    {
      "id": "mosdac-gsmap",
      "provider": "ISRO MOSDAC",
      "name": "GSMaP-ISRO rainfall",
