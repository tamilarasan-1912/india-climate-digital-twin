# Public FastAPI URL deployed on Render
NEXT_PUBLIC_API_URL=https://your-api.onrender.com
# Optional source endpoints. Set only to validated provider/API endpoints.
# These variables configure adapters; they do not themselves create or validate climate data.
CLIMATE_PROVIDER_TEMPERATURE_URL=
CLIMATE_PROVIDER_LST_URL=
CLIMATE_PROVIDER_SST_URL=
CLIMATE_PROVIDER_ANOMALIES_URL=

# Production API security
CORS_ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app
# Optional filesystem cache lifetime for administrative boundaries (seconds)
ADMIN_BOUNDARY_CACHE_TTL=21600
