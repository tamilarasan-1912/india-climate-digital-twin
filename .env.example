# Public FastAPI URL deployed on Render. In local development, omit this
# variable to use the Next.js server-side proxy at http://127.0.0.1:8000.
NEXT_PUBLIC_API_URL=

# Optional comma-separated hostnames allowed to request Next.js dev-only
# resources (including the HMR WebSocket). Use hostnames only, without a
# scheme or port, for example: 192.168.1.20,dev.example.test.
# Local IPv4 interfaces and Arena preview hosts are detected automatically.
NEXT_ALLOWED_DEV_ORIGINS=

# Development only. Extra hostnames (comma-separated, no scheme or port) allowed
# to reach dev-only endpoints such as the /_next/hmr WebSocket. Next.js already
# allows localhost and private-range LAN IPs; set this only for a tunnel or an
# unusual subnet you need to load the dev server from.
# ALLOWED_DEV_ORIGINS=tunnel.example.com

# Optional source endpoints. Set only to validated provider/API endpoints.
# These variables configure adapters; they do not themselves create or validate climate data.
# Configuring a URL does NOT mean the provider is connected - it must pass the
# validation pipeline (reachable -> schema -> units -> spatial -> temporal -> quality).
CLIMATE_PROVIDER_TEMPERATURE_URL=
CLIMATE_PROVIDER_LST_URL=
CLIMATE_PROVIDER_SST_URL=
CLIMATE_PROVIDER_ANOMALIES_URL=
# Per-request timeout (seconds) applied to provider adapters.
CLIMATE_PROVIDER_TIMEOUT_SECONDS=20

# Production API security
CORS_ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app
# Operator key protecting administrative/write endpoints (POST/PUT/DELETE under /api/v1).
# When unset the operator boundary is DISABLED and /api/v1/security/status reports
# operator_boundary="disabled_development_mode". Public read APIs stay open either way.
ADMIN_API_KEY=
# Process-local rate limit applied per client IP. This is not a distributed limiter;
# replace with a Redis-backed limiter before horizontal scaling.
RATE_LIMIT_PER_MINUTE=240
# Set to "true" only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Optional filesystem cache lifetime for administrative boundaries (seconds)
ADMIN_BOUNDARY_CACHE_TTL=21600
# Optional mounted path containing validated geoBoundaries files named
# IND-ADM1.geojson and IND-ADM2.geojson. Leave empty to use backend/data/admin_cache.
# Override when the source-data tree is mounted read-only (see docker-compose.yml).
ADMIN_BOUNDARY_CACHE_DIR=
# Local STAC-compatible dataset catalog index directory.
CLIMATE_CATALOG_ROOT=backend/data/catalog
